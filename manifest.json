{
  "manifest_version": 3,
  "name": "Claude Chat Outline",
  "version": "1.0.0",
  "description": "A clickable outline of your own questions in claude.ai chats.",
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/selectors.js", "src/outline.js", "src/panel.js", "src/main.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/panel.css"],
      "matches": ["https://claude.ai/*"]
    }
  ]
}
